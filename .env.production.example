# Produção (branch main). Copie para a Vercel em Settings → Environment Variables,
# ambiente "Production". Este arquivo é só referência: o Next não o carrega.

# Contagem "Em breve" sobre o hero até o lançamento (23/11/2026).
NEXT_PUBLIC_LAUNCH_COUNTDOWN_ENABLED=true

# Endereço público da landing: base do canonical, Open Graph, robots.txt e sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO-DE-PRODUCAO

# SIGEM-app (links de login e cadastro).
NEXT_PUBLIC_APP_URL=https://ENDERECO-DO-APP

# SIGEM-api (formulário "Avise-me no lançamento"). A API precisa ter
# LANDING_URL=https://SEU-DOMINIO-DE-PRODUCAO para liberar o CORS.
NEXT_PUBLIC_API_URL=https://ENDERECO-DA-API
