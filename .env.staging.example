# Homologação (branch staging). Copie para a Vercel em Settings → Environment
# Variables, ambiente "Preview", marcando a branch "staging" (Preview → Select
# Git Branch). Assim estes valores valem só para a staging, não para os outros
# previews. Este arquivo é só referência: o Next não o carrega.

# Igual à produção: a Alessandra testa exatamente o que vai subir.
NEXT_PUBLIC_LAUNCH_COUNTDOWN_ENABLED=true

# Endereço fixo da homologação na Vercel (o domínio da branch staging).
NEXT_PUBLIC_SITE_URL=https://ENDERECO-DA-HOMOLOGACAO

NEXT_PUBLIC_APP_URL=https://ENDERECO-DO-APP
# A API precisa ter LANDING_URL=https://ENDERECO-DA-HOMOLOGACAO para liberar o CORS.
NEXT_PUBLIC_API_URL=https://ENDERECO-DA-API
