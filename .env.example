# Endereço público da landing (canonical, Open Graph, sitemap). Obrigatório em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contagem "Em breve" sobre o hero até o lançamento. false = landing direto (desenvolvimento).
# Sem a variável, a contagem fica ligada. Produção (main): true. dev/homologação: false.
NEXT_PUBLIC_LAUNCH_COUNTDOWN_ENABLED=false
# SIGEM-api, usada pelo formulário "Avise-me no lançamento"
NEXT_PUBLIC_API_URL=http://localhost:3001
