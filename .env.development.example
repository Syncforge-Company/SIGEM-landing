# Desenvolvimento e homologação (branch dev, onde a Alessandra testa, e previews
# de PR). Copie para a Vercel em Settings → Environment Variables, ambiente
# "Preview". Este arquivo é só referência: o Next não o carrega.

# Landing direto, sem a contagem, para trabalhar e testar o layout.
NEXT_PUBLIC_LAUNCH_COUNTDOWN_ENABLED=false

# Endereço fixo da dev na Vercel (o domínio associado à branch dev).
NEXT_PUBLIC_SITE_URL=https://ENDERECO-DA-DEV

NEXT_PUBLIC_APP_URL=https://ENDERECO-DO-APP
# A API precisa ter LANDING_URL=https://ENDERECO-DA-DEV para liberar o CORS.
NEXT_PUBLIC_API_URL=https://ENDERECO-DA-API
