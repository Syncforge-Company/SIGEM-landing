# Desenvolvimento (branch dev e previews de PR). Copie para a Vercel em Settings →
# Environment Variables, ambiente "Preview" (todas as branches). A staging tem
# os próprios valores, que valem por cima destes. Este arquivo é só referência.

# Landing direto, sem a contagem, para trabalhar no layout.
NEXT_PUBLIC_LAUNCH_COUNTDOWN_ENABLED=false

NEXT_PUBLIC_SITE_URL=https://ENDERECO-DOS-PREVIEWS
NEXT_PUBLIC_APP_URL=https://ENDERECO-DO-APP
NEXT_PUBLIC_API_URL=https://ENDERECO-DA-API
